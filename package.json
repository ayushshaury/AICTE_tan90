{
  "name": "aicte-verifyai-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "start": "npm --prefix backend run start",
    "test": "npm --prefix backend run test",
    "test:backend": "npm --prefix backend run test",
    "prisma:seed": "npm --prefix backend run prisma:seed",
    "prisma:push": "npm --prefix backend run prisma:push",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "dev:server": "npm run dev:backend",
    "dev:client": "npm run dev:frontend",
    "build:server": "npm run build:backend",
    "build:client": "npm run build:frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
